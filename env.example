# Copy to .env and fill in. Never commit .env.
#   cp env.example .env && chmod 600 .env

# Match the user that owns ./volumes/wiki-config on the host, or BookStack
# will boot but fail to write uploads with an opaque 500 error.
#   id -u   ->  PUID
#   id -g   ->  PGID
PUID=1000
PGID=1000

# --- Wiki --------------------------------------------------------
# Generate with:
#   docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:25.05.2 appkey
# Paste the whole thing including the "base64:" prefix.
# Changing this later invalidates all sessions and breaks anything
# already encrypted in the database, so set it once and back it up.
WIKI_APP_KEY=

# Generate with: openssl rand -base64 24
WIKI_DB_ROOT_PASSWORD=
WIKI_DB_PASSWORD=

# --- Engine ------------------------------------------------------
# Generate with: openssl rand -base64 24
ENGINE_DB_PASSWORD=
